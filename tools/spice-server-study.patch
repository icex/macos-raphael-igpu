@@ -0,0 +1,63 @@
+// Diagnostic only. No exported ABI or drawing/queue policy changes.
+#include "config.h"
+#include "rgpu-study.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <glib.h>
+namespace {
+struct Study {
+    std::atomic<uint64_t> values[RG_STUDY_COUNT] {};
+    std::atomic<bool> reported {false};
+    bool enabled = false;
+    gint64 start = 0, end = 0;
+    static bool number(const char *s, unsigned max, unsigned *out) {
+        if (!s || !*s) return false;
+        unsigned n = 0;
+        for (; *s; ++s) {
+            if (*s < '0' || *s > '9' || n > max / 10) return false;
+            n = n * 10 + (*s - '0'); if (n > max) return false;
+        }
+        *out = n; return true;
+    }
+    Study() {
+        const char *s = std::getenv("RGPU_SPICE_STUDY_SECONDS");
+        if (!s) return;
+        unsigned seconds = 0, delay = 0;
+        const char *d = std::getenv("RGPU_SPICE_STUDY_DELAY");
+        if (!number(s,120,&seconds) || !seconds || (d && !number(d,30,&delay))) {
+            std::fprintf(stderr,"RGPU_SPICE_STUDY invalid_config=1\n"); return;
+        }
+        start = g_get_monotonic_time() + (gint64)delay * G_USEC_PER_SEC;
+        end = start + (gint64)seconds * G_USEC_PER_SEC; enabled = true;
+        g_timeout_add(20, [](gpointer p)->gboolean {
+            auto *s = static_cast<Study *>(p);
+            if (g_get_monotonic_time() < s->end) return G_SOURCE_CONTINUE;
+            s->report(true); return G_SOURCE_REMOVE;
+        },this);
+    }
+    void report(bool complete) {
+        if (!enabled || reported.exchange(true)) return;
+        static const char *names[] = {"draw_consumed","draw_parsed","opaque_equal_replacements",
+            "pending_pipe_removals","equal_pending_pipe_removals","draw_copy_marshal_entries",
+            "draw_copy_marshal_completed","draw_copy_marshal_us","display_write_bytes",
+            "display_outgoing_buffers_completed","display_completed_buffer_bytes",
+            "display_write_eagain","display_blocked_polls","display_ack_wait_polls"};
+        std::fprintf(stderr,"RGPU_SPICE_STUDY {\"schema\":1,\"complete\":%s,\"start_us\":%lld,\"end_us\":%lld,\"reported_us\":%lld",
+            complete?"true":"false",(long long)start,(long long)end,(long long)g_get_monotonic_time());
+        for (unsigned i=0;i<RG_STUDY_COUNT;i++)
+            std::fprintf(stderr,",\"%s\":%llu",names[i],(unsigned long long)values[i].load());
+        std::fprintf(stderr,"}\n"); std::fflush(stderr);
+    }
+    ~Study() { report(g_get_monotonic_time()>=end); }
+};
+Study &study() { static Study s; return s; }
+}
+void rgpu_study_add(RGStudyCounter counter, uint64_t value) {
+    Study &s = study();
+    if (!s.enabled || s.reported.load(std::memory_order_relaxed)) return;
+    gint64 now = g_get_monotonic_time();
+    if (now < s.start || now >= s.end) return;
+    s.values[counter].fetch_add(value,std::memory_order_relaxed);
+}
