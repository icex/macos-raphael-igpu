+/* Run the refresh of the listeners showing @con now, outside the timer. */
+void qemu_console_refresh_now(QemuConsole *con)
+{
+    DisplayState *s = con ? con->ds : NULL;
+    DisplayChangeListener *dcl;
+
+    if (!s || s->refreshing) {
+        return;
+    }
+    s->refreshing = true;
+    QLIST_FOREACH(dcl, &s->listeners, next) {
+        if (dcl->con && dcl->con != con) {
+            continue;
+        }
+        if (dcl->ops->dpy_refresh) {
+            dcl->ops->dpy_refresh(dcl);
+        }
+    }
+    s->refreshing = false;
+}
