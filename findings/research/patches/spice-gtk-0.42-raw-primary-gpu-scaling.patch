+    glCompileShader(id);
+    glGetShaderiv(id, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        gchar log[1024];
+        glGetShaderInfoLog(id, sizeof(log), NULL, log);
+        g_warning("RGPU_RAW_GL shader: %s", log);
+        glDeleteShader(id);
+        return 0;
+    }
+    return id;
+}
