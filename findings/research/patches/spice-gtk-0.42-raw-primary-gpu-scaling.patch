+    static const gchar *fs = "#version 150\nuniform sampler2D image; uniform vec2 uv_min,uv_max; in vec2 tc; out vec4 color;\nvoid main(){color=vec4(texture(image,clamp(tc,uv_min,uv_max)).rgb,1);}";
