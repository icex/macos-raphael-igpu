+static gboolean write_all(gint fd, const void *data, gsize length)
+{
+    const guchar *cursor = data;
+    while (length) {
+        ssize_t count = write(fd, cursor, length);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) return FALSE;
+        cursor += count;
+        length -= count;
+    }
+    return TRUE;
+}
