+static void unrealize(GtkGLArea *area, gpointer opaque)
+{
+    SpiceDisplay *display=opaque;SpiceDisplayPrivate *d=display->priv;
+    gtk_gl_area_make_current(area);
+    if(!gtk_gl_area_get_error(area)){
+        if(d->raw_gl.texture)glDeleteTextures(1,&d->raw_gl.texture);
+        if(d->raw_gl.program)glDeleteProgram(d->raw_gl.program);
+        if(d->raw_gl.vao)glDeleteVertexArrays(1,&d->raw_gl.vao);
+        if(d->raw_gl.vbo)glDeleteBuffers(1,&d->raw_gl.vbo);
+    }
+    d->raw_gl.texture=d->raw_gl.program=d->raw_gl.vao=d->raw_gl.vbo=0;
+    d->raw_gl.texture_width=d->raw_gl.texture_height=0;d->raw_gl.full_upload=TRUE;
