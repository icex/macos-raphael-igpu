+static void verify_frame(SpiceDisplay *display, gint width, gint height)
+{
+    SpiceDisplayPrivate *d = display->priv;
+    gchar *request_path, request[19], *path, *partial;
+    gsize length = 0;
+    guchar *rgb;
+    gint fd, row, alignment, row_length, skip_rows, skip_pixels, pbo;
+    gboolean ok;
+    if (!d->raw_gl.verify_dir) return;
+    request_path = g_build_filename(d->raw_gl.verify_dir, "request", NULL);
+    fd = g_open(request_path, O_RDONLY | O_NONBLOCK | O_CLOEXEC, 0);
+    g_free(request_path);
+    if (fd < 0) return;
+    while (length < 18) {
+        ssize_t count = read(fd, request + length, 18 - length);
+        if (count < 0 && errno == EINTR) continue;
+        if (count < 0) { close(fd); return; }
+        if (count == 0) break;
+        length += count;
+    }
+    close(fd);
+    if (length != 16 && !(length == 17 && request[16] == '\n')) return;
+    for (row = 0; row < 16; row++) if (!g_ascii_isxdigit(request[row])) return;
+    request[16] = 0;
+    if (g_strcmp0(request, d->raw_gl.last_request) == 0) return;
+    if (width <= 0 || height <= 0 || (gsize)width > G_MAXSIZE / 3 / (gsize)height) return;
+    path = g_strdup_printf("%s/frame-%s.ppm", d->raw_gl.verify_dir, request);
+    partial = g_strconcat(path, ".partial", NULL);
+    fd = g_open(partial, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) { g_free(partial); g_free(path); return; }
+    rgb = g_malloc((gsize)width * height * 3);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skip_rows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skip_pixels);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pbo);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glReadPixels(0, 0, width, height, GL_RGB, GL_UNSIGNED_BYTE, rgb);
+    ok = glGetError() == GL_NO_ERROR;
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo);
+    if (ok) {
+        gchar header[64];
+        gint n = g_snprintf(header, sizeof(header), "P6\n%d %d\n255\n", width, height);
+        ok = write_all(fd, header, n);
+        for (row = height - 1; row >= 0 && ok; row--)
+            ok = write_all(fd, rgb + (gsize)row * width * 3, (gsize)width * 3);
+    }
+    if (close(fd) != 0) ok = FALSE;
+    /* link publishes only a complete closed file and never replaces an existing result. */
+    if (ok) ok = link(partial, path) == 0;
+    g_unlink(partial);
+    if (ok) {
+        g_free(d->raw_gl.last_request);
+        d->raw_gl.last_request = g_strdup(request);
+        g_message("RGPU_RAW_GL framebuffer=%s pixels=%dx%d", path, width, height);
+    }
+    g_free(rgb); g_free(partial); g_free(path);
+}
