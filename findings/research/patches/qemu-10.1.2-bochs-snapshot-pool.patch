--- /dev/null
+++ b/hw/display/bochs-snapshot-pool.h
@@ -0,0 +1,207 @@
+/* Host-private snapshot backing. Never export an FD or share_handle.
+ * Each image lease owns a distinct Pixman wrapper. Only its FINAL destroy
+ * callback returns the externally-owned backing. Callbacks never touch devices,
+ * BQL or display/listener locks. Lock order is caller lock -> pool mutex only.
+ */
+#ifndef BOCHS_SNAPSHOT_POOL_H
+#define BOCHS_SNAPSHOT_POOL_H
+#include <glib.h>
+#include <pixman.h>
+#include <stdint.h>
+#include <stdbool.h>
+#define BSP_SLOTS 3u
+#define BSP_BYTES (32u * 1024u * 1024u)
+typedef struct BochsSnapshotPool BochsSnapshotPool;
+typedef struct BochsSnapshotBlock {
+    BochsSnapshotPool *pool;
+    struct BochsSnapshotBlock *next;
+    uint8_t *data;
+} BochsSnapshotBlock;
+typedef struct BochsSnapshotPoolStats {
+    uint64_t attempts, created, reused, success, fallback;
+    uint64_t allocation_failed, capacity_failed, closed_failed, invalid_failed;
+    bool saturated;
+} BochsSnapshotPoolStats;
+enum BspOutcome { BSP_NEW, BSP_REUSED, BSP_ALLOC_FAILED, BSP_CAPACITY,
+                  BSP_CLOSED, BSP_INVALID };
+struct BochsSnapshotPool {
+    GMutex mutex;
+    BochsSnapshotPoolStats stats;
+    gint refs; /* One device ref plus one per reserved/live/idle block. */
+    unsigned slots;
+    size_t bytes;
+    bool closed;
+    BochsSnapshotBlock *idle;
+};
+static inline void bsp_count(BochsSnapshotPoolStats *s, uint64_t *value)
+{
+    if (*value == UINT64_MAX) {
+        s->saturated = true;
+    } else {
+        ++*value;
+    }
+}
+static inline BochsSnapshotPoolStats bsp_stats(BochsSnapshotPool *p,
+                                               unsigned *slots, size_t *bytes)
+{
+    BochsSnapshotPoolStats result;
+    g_mutex_lock(&p->mutex);
+    result = p->stats;
+    *slots = p->slots;
+    *bytes = p->bytes;
+    g_mutex_unlock(&p->mutex);
+    return result;
+}
+static inline BochsSnapshotPool *bsp_new(void)
+{
+    BochsSnapshotPool *p = g_new0(BochsSnapshotPool, 1);
+    g_mutex_init(&p->mutex);
+    p->refs = 1;
+    return p;
+}
+static inline void bsp_unref(BochsSnapshotPool *p)
+{
+    if (g_atomic_int_dec_and_test(&p->refs)) {
+        g_assert(p->closed && !p->slots && !p->bytes && !p->idle);
+        g_mutex_clear(&p->mutex);
+        g_free(p);
+    }
+}
+static inline void bsp_unreserve(BochsSnapshotPool *p)
+{
+    g_mutex_lock(&p->mutex);
+    g_assert(p->slots && p->bytes >= BSP_BYTES);
+    p->slots--;
+    p->bytes -= BSP_BYTES;
+    g_mutex_unlock(&p->mutex);
+    bsp_unref(p);
+}
+static inline void bsp_return(pixman_image_t *image, void *opaque)
+{
+    BochsSnapshotBlock *b = opaque;
+    BochsSnapshotPool *p = b->pool;
+    bool closed;
+    (void)image;
+    g_mutex_lock(&p->mutex);
+    closed = p->closed;
+    if (!closed) {
+        b->next = p->idle;
+        p->idle = b;
+    }
+    g_mutex_unlock(&p->mutex);
+    if (closed) {
+        g_free(b->data);
+        g_free(b);
+        bsp_unreserve(p);
+    }
+}
+static inline pixman_image_t *bsp_take(BochsSnapshotPool *p,
+                                     uint32_t w, uint32_t h, enum BspOutcome *outcome)
+{
+    BochsSnapshotBlock *b;
+    pixman_image_t *image;
+    bool reused;
+    *outcome = BSP_ALLOC_FAILED;
+    if (!w || !h || w > 3840 || h > 2160 || (uint64_t)w * h * 4 > BSP_BYTES) {
+        *outcome = BSP_INVALID;
+        return NULL;
+    }
+    g_mutex_lock(&p->mutex);
+    if (p->closed) {
+        *outcome = BSP_CLOSED;
+        g_mutex_unlock(&p->mutex);
+        return NULL;
+    }
+    b = p->idle;
+    reused = b != NULL;
+    if (b) {
+        p->idle = b->next;
+        b->next = NULL;
+        g_mutex_unlock(&p->mutex);
+    } else {
+        if (p->slots >= BSP_SLOTS || p->bytes > BSP_SLOTS * (size_t)BSP_BYTES - BSP_BYTES) {
+            g_mutex_unlock(&p->mutex);
+            *outcome = BSP_CAPACITY;
+            return NULL; /* Caller uses existing fresh surface allocation. */
+        }
+        p->slots++;
+        p->bytes += BSP_BYTES;
+        g_atomic_int_inc(&p->refs);
+        g_mutex_unlock(&p->mutex);
+        b = g_try_new0(BochsSnapshotBlock, 1);
+        if (!b) {
+            bsp_unreserve(p);
+            return NULL;
+        }
+        b->pool = p;
+        b->data = g_try_malloc(BSP_BYTES);
+        if (!b->data) {
+            g_free(b);
+            bsp_unreserve(p);
+            return NULL;
+        }
+    }
+    if (!reused) {
+        g_mutex_lock(&p->mutex);
+        bsp_count(&p->stats, &p->stats.created);
+        g_mutex_unlock(&p->mutex);
+    }
+    image = pixman_image_create_bits(PIXMAN_x8r8g8b8, w, h,
+                                     (uint32_t *)b->data, w * 4);
+    if (!image) {
+        bsp_return(NULL, b);
+        return NULL;
+    }
+    pixman_image_set_destroy_function(image, bsp_return, b);
+    *outcome = reused ? BSP_REUSED : BSP_NEW;
+    return image;
+}
+/* One completed outcome per request. A temporary ref covers failure cleanup
+ * even if the device owner closes while a reserved block is being allocated. */
+static inline pixman_image_t *bsp_image(BochsSnapshotPool *p, uint32_t w, uint32_t h)
+{
+    enum BspOutcome outcome;
+    pixman_image_t *image;
+    g_atomic_int_inc(&p->refs);
+    image = bsp_take(p, w, h, &outcome);
+    g_mutex_lock(&p->mutex);
+    bsp_count(&p->stats, &p->stats.attempts);
+    if (image) {
+        bsp_count(&p->stats, &p->stats.success);
+        if (outcome == BSP_REUSED) {
+            bsp_count(&p->stats, &p->stats.reused);
+        }
+    } else {
+        bsp_count(&p->stats, &p->stats.fallback);
+        switch (outcome) {
+        case BSP_CAPACITY: bsp_count(&p->stats, &p->stats.capacity_failed); break;
+        case BSP_CLOSED: bsp_count(&p->stats, &p->stats.closed_failed); break;
+        case BSP_INVALID: bsp_count(&p->stats, &p->stats.invalid_failed); break;
+        default: bsp_count(&p->stats, &p->stats.allocation_failed); break;
+        }
+    }
+    g_mutex_unlock(&p->mutex);
+    bsp_unref(p);
+    return image;
+}
+/* Caller detaches its pointer and drops the sole device ref exactly once.
+ * In-flight image/block refs preserve the pool after this function returns. */
+static inline void bsp_close(BochsSnapshotPool *p)
+{
+    BochsSnapshotBlock *b, *next;
+    g_mutex_lock(&p->mutex);
+    g_assert(!p->closed);
+    p->closed = true;
+    b = p->idle;
+    p->idle = NULL;
+    g_mutex_unlock(&p->mutex);
+    while (b) {
+        next = b->next;
+        g_free(b->data);
+        g_free(b);
+        bsp_unreserve(p);
+        b = next;
+    }
+    bsp_unref(p);
+}
+#endif
