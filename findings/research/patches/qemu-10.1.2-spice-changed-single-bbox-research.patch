@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Research helper: union of changed packed xRGB pixels, never a list of tiles.
+ * No memory mutation; caller owns stable source and initialized mirror.
+ */
+#ifndef RGPU_SPICE_DIFF_BBOX_H
+#define RGPU_SPICE_DIFF_BBOX_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+typedef struct RGPUDiffRect { int left, top, right, bottom; } RGPUDiffRect;
+
+/* -1 invalid input (caller sends full surface), 0 identical, 1 changed bbox. */
+static int rgpu_diff_bbox(const uint8_t *source, size_t source_bytes,
+                         size_t source_stride, const uint8_t *mirror,
+                         size_t mirror_bytes, size_t mirror_stride,
+                         int width, int height, RGPUDiffRect dirty,
+                         RGPUDiffRect *out)
+{
+    size_t row_bytes;
+    int y, left, right, found = 0;
+    if (!source || !mirror || !out || width <= 0 || height <= 0 ||
+        width > 3840 || height > 2160 || dirty.left < 0 || dirty.top < 0 ||
+        dirty.right > width || dirty.bottom > height ||
+        dirty.left >= dirty.right || dirty.top >= dirty.bottom) {
+        return -1;
+    }
+    row_bytes = (size_t)width * 4;
+    if (source_stride < row_bytes || mirror_stride < row_bytes ||
+        source_stride > SIZE_MAX / (size_t)height ||
+        mirror_stride > SIZE_MAX / (size_t)height ||
+        source_bytes < source_stride * (size_t)height ||
+        mirror_bytes < mirror_stride * (size_t)height) {
+        return -1;
+    }
+    *out = (RGPUDiffRect){dirty.right, dirty.bottom, dirty.left, dirty.top};
+    for (y = dirty.top; y < dirty.bottom; y++) {
+        const uint8_t *a = source + (size_t)y * source_stride;
+        const uint8_t *b = mirror + (size_t)y * mirror_stride;
+        if (!memcmp(a + (size_t)dirty.left * 4, b + (size_t)dirty.left * 4,
+                    (size_t)(dirty.right - dirty.left) * 4)) {
+            continue;
+        }
+        left = dirty.left;
+        while (!memcmp(a + (size_t)left * 4, b + (size_t)left * 4, 4)) {
+            left++;
+        }
+        right = dirty.right;
+        while (!memcmp(a + (size_t)(right - 1) * 4,
+                       b + (size_t)(right - 1) * 4, 4)) {
+            right--;
+        }
+        if (left < out->left) out->left = left;
+        if (right > out->right) out->right = right;
+        if (!found) out->top = y;
+        out->bottom = y + 1;
+        found = 1;
+    }
+    return found;
+}
+#endif
