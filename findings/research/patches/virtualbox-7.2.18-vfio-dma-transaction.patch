+/** Successful extents of the current map transaction, newest first. */
+struct VFIOPDMAEXTENT
+{
+    VFIOPDMAEXTENT *pNext;
+    RTGCPHYS GCPhys;
+    size_t cb;
+};
+
+static int pciVfioUnmapRegion(PVFIOPCI pThis, RTGCPHYS GCPhys, size_t cb)
+{
+    if (pThis->fVfioLegacy)
+    {
+        struct vfio_iommu_type1_dma_unmap Unmap = {};
+        Unmap.argsz = sizeof(Unmap);
+        Unmap.iova = GCPhys;
+        Unmap.size = cb;
+        if (ioctl(pThis->VfioGroup.iFdVfioContainer, VFIO_IOMMU_UNMAP_DMA, &Unmap) == -1)
+            return RTErrConvertFromErrno(errno);
+        return Unmap.size == cb ? VINF_SUCCESS : VERR_IO_GEN_FAILURE;
+    }
+    struct iommu_ioas_unmap Unmap = {};
+    Unmap.size = sizeof(Unmap);
+    Unmap.ioas_id = pThis->IommuFd.idIommuHwpt;
+    Unmap.iova = GCPhys;
+    Unmap.length = cb;
+    if (ioctl(pThis->IommuFd.iFdIommu, IOMMU_IOAS_UNMAP, &Unmap) == -1)
+        return RTErrConvertFromErrno(errno);
+    return Unmap.length == cb ? VINF_SUCCESS : VERR_IO_GEN_FAILURE;
+}
+
+static int pciVfioMapRecorded(PVFIOPCI pThis, RTGCPHYS GCPhys, uintptr_t uPtr,
+                              size_t cb, VFIOPDMAEXTENT **ppHead)
+{
+    /* Allocate before the ioctl: every successful mapping must be recorded. */
+    VFIOPDMAEXTENT *pExtent = (VFIOPDMAEXTENT *)RTMemAlloc(sizeof(*pExtent));
+    if (!pExtent)
+        return VERR_NO_MEMORY;
+    int rc = pciVfioMapRegion(pThis, GCPhys, uPtr, cb);
+    if (RT_FAILURE(rc))
+    {
+        RTMemFree(pExtent);
+        return rc;
+    }
+    pExtent->GCPhys = GCPhys;
+    pExtent->cb = cb;
+    pExtent->pNext = *ppHead;
+    *ppHead = pExtent;
+    return VINF_SUCCESS;
+}
