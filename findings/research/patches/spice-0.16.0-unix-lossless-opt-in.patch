--- /dev/null
+++ b/server/rgpu-unix-lossless.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Research-only policy; unchanged default Unix behavior.
+ */
+#ifndef RGPU_UNIX_LOSSLESS_H
+#define RGPU_UNIX_LOSSLESS_H
+#include <sys/socket.h>
+#include <spice/enums.h>
+
+static inline bool rgpu_unix_compression_allowed(int family,
+                                                SpiceImageCompression codec,
+                                                const char *opt)
+{
+    if (family != AF_UNIX) return true;
+    return codec == SPICE_IMAGE_COMPRESSION_LZ4 &&
+           opt && opt[0] == '1' && opt[1] == '\0';
+}
+#endif
