+/* Successful commits only; stage order is allocation, copy, pending free.
+ * Copy includes first-touch faults. Dispatch/BQL wait precedes these samples. */
+static void bochs_snapshot_timing_record(BochsDisplayState *s, uint32_t w,
+                                        uint32_t h, bool pending,
+                                        const int64_t t[4])
+{
+    BochsSnapshotTiming *stats = &s->snapshot_timing;
+    uint64_t us[BST_STAGES];
+    unsigned i;
+    for (i = 0; i < BST_STAGES; i++) {
+        if (t[i] < 0 || t[i + 1] < t[i]) {
+            return;
+        }
+        us[i] = t[i + 1] - t[i];
+    }
+    if (!stats->begun) {
+        stats->started = t[0];
+        stats->begun = true;
+    }
+    if (!bst_record(stats, t[3], w, h, pending, us)) {
+        return;
+    }
+    for (i = 0; i < BST_SLOTS; i++) {
+        BochsSnapshotTimingBucket *b = &stats->buckets[i];
+        if (!b->count) {
+            continue;
+        }
+        fprintf(stderr, "bochs-snapshot-timing window=%u start_us=%" PRIu64
+                " end_us=%" PRIu64 " geometry=%ux%u commits=%" PRIu64
+                " alloc_calls=%" PRIu64 " copy_calls=%" PRIu64
+                " free_calls=%" PRIu64 " pending_present=%" PRIu64
+                " pending_null=%" PRIu64
+                " alloc_us=%" PRIu64 "/%" PRIu64
+                " copy_us=%" PRIu64 "/%" PRIu64
+                " free_us=%" PRIu64 "/%" PRIu64
+                " dropped_geometry=%" PRIu64 " saturated=%u\n",
+                stats->windows + 1, stats->started, (uint64_t)t[3],
+                b->width, b->height, b->count, b->count, b->count, b->count,
+                b->pending_present, b->count - b->pending_present,
+                b->total[0], b->maximum[0], b->total[1], b->maximum[1],
+                b->total[2], b->maximum[2], stats->dropped, stats->saturated);
+    }
+    bst_clear(stats, t[3]);
+}
