--- /dev/null
+++ b/hw/display/bochs-snapshot-timing.h
@@ -0,0 +1,80 @@
+/* Bounded diagnostic policy. Access serialized by the device's BQL. */
+#ifndef BOCHS_SNAPSHOT_TIMING_H
+#define BOCHS_SNAPSHOT_TIMING_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#define BST_SLOTS 8
+#define BST_STAGES 3
+#define BST_WINDOWS 128
+#define BST_PERIOD_US 5000000ULL
+typedef struct BochsSnapshotTimingBucket {
+    uint32_t width, height;
+    uint64_t count, pending_present;
+    uint64_t total[BST_STAGES], maximum[BST_STAGES];
+} BochsSnapshotTimingBucket;
+typedef struct BochsSnapshotTiming {
+    BochsSnapshotTimingBucket buckets[BST_SLOTS];
+    uint64_t started, dropped;
+    unsigned windows;
+    bool begun, saturated;
+} BochsSnapshotTiming;
+static inline void bst_add(BochsSnapshotTiming *s, uint64_t *v, uint64_t n)
+{
+    if (UINT64_MAX - *v < n) {
+        *v = UINT64_MAX;
+        s->saturated = true;
+    } else {
+        *v += n;
+    }
+}
+static inline bool bst_record(BochsSnapshotTiming *s, uint64_t now,
+                             uint32_t w, uint32_t h, bool pending,
+                             const uint64_t us[BST_STAGES])
+{
+    BochsSnapshotTimingBucket *b = NULL;
+    unsigned i;
+    if (s->windows >= BST_WINDOWS) {
+        return false;
+    }
+    if (!s->begun) {
+        s->begun = true;
+        s->started = now;
+    }
+    for (i = 0; i < BST_SLOTS; i++) {
+        if (!s->buckets[i].count ||
+            (s->buckets[i].width == w && s->buckets[i].height == h)) {
+            b = &s->buckets[i];
+            break;
+        }
+    }
+    if (!b) {
+        bst_add(s, &s->dropped, 1);
+    } else {
+        b->width = w;
+        b->height = h;
+        bst_add(s, &b->count, 1);
+        if (pending) {
+            bst_add(s, &b->pending_present, 1);
+        }
+        for (i = 0; i < BST_STAGES; i++) {
+            bst_add(s, &b->total[i], us[i]);
+            if (us[i] > b->maximum[i]) {
+                b->maximum[i] = us[i];
+            }
+        }
+    }
+    return now >= s->started && now - s->started >= BST_PERIOD_US;
+}
+static inline void bst_clear(BochsSnapshotTiming *s, uint64_t now)
+{
+    memset(s->buckets, 0, sizeof(s->buckets));
+    s->started = now;
+    s->begun = true;
+    s->dropped = 0;
+    s->saturated = false;
+    if (s->windows < BST_WINDOWS) {
+        s->windows++;
+    }
+}
+#endif
