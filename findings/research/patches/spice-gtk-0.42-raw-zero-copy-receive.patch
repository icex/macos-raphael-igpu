+#define RGPU_LARGE_MSG (1 << 20)
+int rgpu_large_misalign; /* set by the canvas for wrapped-candidate raw bitmaps */
+static int rgpu_large_shift;
+static uint8_t *rgpu_large_cached;
+static size_t rgpu_large_cached_size;
+
+static uint8_t *rgpu_large_take(size_t size, size_t *out_size)
+{
+    if (rgpu_large_cached && rgpu_large_cached_size >= size) {
+        uint8_t *p = rgpu_large_cached;
+        *out_size = rgpu_large_cached_size;
+        rgpu_large_cached = NULL;
+        return p;
+    }
+    *out_size = size;
+    return g_malloc(size);
+}
+
+static void rgpu_large_release(uint8_t *p, size_t size)
+{
+    if (!rgpu_large_cached || rgpu_large_cached_size < size) {
+        g_free(rgpu_large_cached);
+        rgpu_large_cached = p;
+        rgpu_large_cached_size = size;
+    } else {
+        g_free(p);
+    }
+}
+
