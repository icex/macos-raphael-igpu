--- /dev/null
+++ b/ui/gui-start-pacing.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT
+ * Experimental start-relative GUI scheduling. Skip expired ticks, never replay.
+ */
+#ifndef RGPU_GUI_START_PACING_H
+#define RGPU_GUI_START_PACING_H
+#include <stdint.h>
+#include <limits.h>
+
+static int64_t rgpu_gui_next_tick(int64_t start, int64_t now, uint64_t period)
+{
+    uint64_t ticks, origin;
+    if (!period || period > INT64_MAX || now < 0) return INT64_MAX;
+    if (start < 0 || start > now) start = now;
+    origin = (uint64_t)start;
+    ticks = ((uint64_t)now - origin) / period + 1;
+    if (ticks > ((uint64_t)INT64_MAX - origin) / period) return INT64_MAX;
+    return (int64_t)(origin + ticks * period);
+}
+#endif
