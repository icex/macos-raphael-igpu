--- /dev/null
+++ b/server/rgpu-unix-lossless-client.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Research policy: explicit client LZ4 only; default Unix remains raw.
+ */
+#ifndef RGPU_UNIX_LOSSLESS_CLIENT_H
+#define RGPU_UNIX_LOSSLESS_CLIENT_H
+#include <sys/socket.h>
+#include <spice/enums.h>
+
+static inline bool rgpu_unix_client_compression_allowed(int family,
+                                                       SpiceImageCompression codec)
+{
+    return family != AF_UNIX || codec == SPICE_IMAGE_COMPRESSION_LZ4;
+}
+#endif
