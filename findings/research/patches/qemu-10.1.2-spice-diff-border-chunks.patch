+/* Safe for arbitrary byte alignment; memcpy folds to a 32-bit load. */
+static int rgpu_pixel_equal(const uint8_t *a, const uint8_t *b)
+{
+    uint32_t av, bv;
+    memcpy(&av, a, sizeof(av));
+    memcpy(&bv, b, sizeof(bv));
+    return av == bv;
+}
 
