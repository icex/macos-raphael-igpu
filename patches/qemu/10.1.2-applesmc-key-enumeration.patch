+/* The index argument is big-endian, just like a four-byte key. */
+static const struct AppleSMCData *applesmc_find_index(AppleSMCState *s)
+{
+    struct AppleSMCData *d;
+    uint32_t index = ((uint32_t)(uint8_t)s->key[0] << 24) |
+                     ((uint32_t)(uint8_t)s->key[1] << 16) |
+                     ((uint32_t)(uint8_t)s->key[2] << 8) |
+                     (uint8_t)s->key[3];
+
+    QLIST_FOREACH(d, &s->data_def, node) {
+        if (index-- == 0) {
+            return d;
+        }
+    }
+    return NULL;
+}
