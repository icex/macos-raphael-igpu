+/*
+ * Raphael desktop: accept any whole number of 16-bit frames per packet, up to twice the
+ * nominal 1 ms size. Guest USB audio drivers (macOS's AppleUSBAudio) send 47- or 49-frame
+ * packets to track clock drift, more often when the guest is busy; rejecting every packet
+ * that is not exactly 48 frames dropped 1 ms of audio each time (audible gaps while
+ * scrolling or moving windows). The ring is byte-addressed and wraps inside a packet.
+ */
 static int streambuf_put(struct streambuf *buf, USBPacket *p, uint32_t channels)
 {
     int64_t free = buf->size - (buf->prod - buf->cons);
+    size_t len = p->iov.size, off, first;
 
-    if (free < USBAUDIO_PACKET_SIZE(channels)) {
+    if (len == 0 || len % (channels * 2) || len > 2 * USBAUDIO_PACKET_SIZE(channels)) {
         return 0;
     }
-    if (p->iov.size != USBAUDIO_PACKET_SIZE(channels)) {
+    if (free < (int64_t)len) {
         return 0;
     }
-
-    /* can happen if prod overflows */
-    assert(buf->prod % USBAUDIO_PACKET_SIZE(channels) == 0);
-    usb_packet_copy(p, buf->data + (buf->prod % buf->size),
-                    USBAUDIO_PACKET_SIZE(channels));
-    buf->prod += USBAUDIO_PACKET_SIZE(channels);
-    return USBAUDIO_PACKET_SIZE(channels);
+    off = buf->prod % buf->size;
+    first = MIN(len, buf->size - off);
+    usb_packet_copy(p, buf->data + off, first);
+    if (len > first) {
+        usb_packet_copy(p, buf->data, len - first);
+    }
+    buf->prod += len;
+    return len;
 }
 
